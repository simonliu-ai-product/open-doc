{
  "name": "@open-document/mcp",
  "version": "0.2.0",
  "description": "MCP server for open-doc — lets any agent framework list, read, write, and file documents over Streamable HTTP.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "document",
    "agent"
  ],
  "license": "MIT",
  "author": {
    "name": "Simon Liu",
    "url": "https://github.com/LiuYuWei"
  },
  "homepage": "https://github.com/simonliu-ai-product/open-doc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonliu-ai-product/open-doc.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/simonliu-ai-product/open-doc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@open-document/core": "^0.3.0"
  },
  "devDependencies": {
    "@open-document/core": "workspace:*",
    "@types/node": "^22.19.17",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
