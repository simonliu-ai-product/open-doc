{
  "name": "@open-doc/core",
  "version": "0.1.0",
  "description": "Runtime and CLI for open-doc \u2014 write documents in docs/, we handle the pages, print layout, and export.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "bin": {
    "open-doc": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "env.d.ts",
    "src/app",
    "skills",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "document",
    "report",
    "pdf",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": {
    "name": "Simon Liu",
    "url": "https://github.com/LiuYuWei"
  },
  "homepage": "https://github.com/simonliu-ai-product/open-doc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonliu-ai-product/open-doc.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/simonliu-ai-product/open-doc/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "chalk": "^6.0.0",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "vite": "^5.4.10"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsdown": "^0.9.9",
    "typescript": "^5.9.3"
  }
}
